# Dev only: plain HTTP on :80 (published as localhost:8080). Production uses on-demand TLS.
{
	auto_https off
}

:80 {
	# The admin SPA comes from the Vite dev server (hot reload); its API and MCP from the app.
	@admin-ui {
		host admin.localhost
		not path /api/* /mcp
	}
	handle @admin-ui {
		reverse_proxy admin:5173
	}
	handle {
		reverse_proxy app:3000
	}
}
