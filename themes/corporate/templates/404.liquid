<section class="block missing">
  <h1 class="display-fit" style="--chars: 3">404</h1>
  <div class="missing-text">
    <h2 class="subhead">{{ 'not_found' | t }}</h2>
    <p class="lead">{{ 'not_found_text' | t }}</p>
    <form class="search-form" action="/" method="get" role="search">
      <label class="visually-hidden" for="q404">{{ 'search' | t }}</label>
      <input id="q404" type="search" name="s" placeholder="{{ 'search_placeholder' | t }}">
      <button class="button" type="submit">{{ 'search' | t }}</button>
    </form>
    <a href="/">{{ 'home' | t }}</a>
  </div>
</section>
