<article class="block article">
  <header class="article-head">
    {%- if post.primary_category -%}<a class="article-up" href="{{ post.primary_category.url }}">{{ post.primary_category.name }}</a>{%- endif -%}
    <h1 class="head">{{ post.title }}</h1>
    <p class="article-meta">
      <time datetime="{{ post.published_at | date: '%Y-%m-%d' }}">{{ post.published_at | date: 'long' }}</time>
      · {{ post.author.name }} · {{ post.content | reading_time }} {{ 'minutes' | t }}
    </p>
  </header>
  {%- if post.featured_image -%}
    <figure class="article-figure">{{ post.featured_image | image_tag: widths: "800,1200,1600", sizes: "(min-width: 1100px) 1100px, 100vw", loading: "eager" }}</figure>
  {%- endif -%}
  <div class="prose">{{ post.content }}</div>
  {%- if post.tags.size > 0 -%}
    <p class="article-tags">{{ 'in' | t }}: {% for tag in post.tags %}<a href="{{ tag.url }}">{{ tag.name }}</a>{% unless forloop.last %}, {% endunless %}{% endfor %}</p>
  {%- endif -%}
</article>
