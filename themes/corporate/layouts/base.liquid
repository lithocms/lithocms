<!doctype html>
<html lang="{{ site.locale }}" dir="{{ site.language_direction }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="theme-color" content="{{ theme.settings.bg }}">
{% seo %}
{% render 'fonts' %}
<style>{{ theme.css_variables }}</style>
<link rel="stylesheet" href="{{ 'theme.css' | asset_url }}">
<script src="{{ 'theme.js' | asset_url }}" defer></script>
{% head_extras %}
{% slot 'head' %}
</head>
<body class="page-{{ request.page_type }}">
<a class="skip" href="#main">{{ 'skip' | t }}</a>
{% render 'header', site: site, menus: menus, settings: theme.settings %}
<main id="main">
{{ content_for_layout }}
</main>
{% render 'footer', site: site, menus: menus, settings: theme.settings, collections: collections %}
{% render 'whatsapp', settings: theme.settings %}
{% slot 'footer' %}
{% body_extras %}
</body>
</html>
