<form class="search-form" action="/" method="get" role="search">
  <label class="visually-hidden" for="{{ id }}">{{ 'search' | t }}</label>
  <input id="{{ id }}" type="search" name="s" value="{{ value }}" placeholder="{{ 'search_placeholder' | t }}">
  <button type="submit">{{ 'search' | t }}</button>
</form>
