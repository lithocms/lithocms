<article class="wrap article">
  <header>
    {%- if post.primary_category -%}<a class="kicker" href="{{ post.primary_category.url }}">{{ post.primary_category.name }}</a>{%- endif -%}
    <h1>{{ post.title }}</h1>
    <p class="muted">
      <time datetime="{{ post.published_at | date: '%Y-%m-%d' }}">{{ post.published_at | date: 'long' }}</time>
      {%- if theme.settings.show_author %} · {{ post.author.name }}{% endif %}
      · {{ post.content | reading_time }} {{ 'minutes' | t }}
    </p>
  </header>
  {%- if post.featured_image -%}
    <figure>{{ post.featured_image | image_tag: widths: "800,1200,1600", sizes: "(min-width: 900px) 900px, 100vw", loading: "eager" }}</figure>
  {%- endif -%}
  <div class="prose">{{ post.content }}</div>
  {%- if post.tags.size > 0 -%}
    <p class="muted">{% for tag in post.tags %}<a href="{{ tag.url }}">#{{ tag.name }}</a>{% unless forloop.last %} {% endunless %}{% endfor %}</p>
  {%- endif -%}
</article>
